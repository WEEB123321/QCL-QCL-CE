    <string name="plugin_hash_verify_name">文件完整性校验</string>
    <string name="plugin_hash_verify_desc">扫实例里的 jar，查 0 字节 / 打不开 / 条目读不出来的损坏文件。只读。</string>
    <string name="plugin_vault_name">密码保险箱</string>
    <string name="plugin_vault_desc">记服务器密码、房间口令。★ 存在应用私有目录，不是加密存储（界面里写明了）。</string>
    <string name="plugin_action_log_name">操作日志</string>
    <string name="plugin_action_log_desc">记录插件做过的写操作（改名、替换、合并、改色…），可回溯。</string>
    <string name="plugin_pack_merge_name">资源包合并</string>
    <string name="plugin_pack_merge_desc">把两个资源包 zip 合成一个，同名文件以上层为准。不删原包。</string>
    <string name="plugin_theme_editor_name">主题编辑器</string>
    <string name="plugin_theme_editor_desc">一键切换启动器主色（8 种），改完立刻生效。</string>
    <string name="plugin_server_ping_name">服务器延迟预检</string>
    <string name="plugin_server_ping_desc">对一批服务器地址测 TCP 连接延迟，进服前先知道哪个能连。</string>
    <string name="plugin_glossary_name">本地化词库</string>
    <string name="plugin_glossary_desc">维护「英文 → 统一译名」对照表，做汉化/写教程时用词统一。</string>
    <string name="plugin_tutorials_name">教程库</string>
    <string name="plugin_tutorials_desc">6 篇本地教程：装版本、装模组、联机、开服、做整合包、排查起不来。全离线。</string>
    <string name="plugin_server_wizard_name">一键开服向导</string>
    <string name="plugin_server_wizard_desc">生成 server.properties 和启动脚本。★ 手机上开服性能差，更适合生成配置给电脑用。</string>
    <string name="plugin_instance_import_name">实例导入向导</string>
    <string name="plugin_instance_import_desc">从 HMCL / PCL2 / 官方启动器 / MultiMC 的目录导入实例，只复制不动原文件。</string>
    <string name="plugin_launch_splash_name">实例启动画面</string>
    <string name="plugin_launch_splash_desc">启动游戏时盖一层纯色 / 进度条画面，不用盯着黑屏。</string>
    <string name="plugin_launch_queue_name">启动队列</string>
    <string name="plugin_launch_queue_desc">把实例排个顺序记下来，依次启动时照单来。</string>
    <string name="plugin_mod_update_name">模组更新预检</string>
    <string name="plugin_mod_update_desc">本地预检：找出重复安装、已锁定的模组。★ 查新版本要联网，本项目不做。</string>
    <string name="plugin_shader_preset_name">光影预设管理</string>
    <string name="plugin_shader_preset_desc">列出光影包并记住你用哪个。★ 真正启用要在游戏内选。</string>
    <string name="plugin_java_match_name">Java 自动匹配</string>
    <string name="plugin_java_match_desc">读版本 json 的 javaVersion，比对已装的运行时，缺了会告诉你。</string>
    <string name="plugin_java_args_name">Java 参数预设</string>
    <string name="plugin_java_args_desc">低配 / 流畅 / 大内存 / 调试 四套 JVM 参数，一键记住。</string>
    <string name="plugin_world_map_name">存档地图预览</string>
    <string name="plugin_world_map_desc">读 region 文件的区块表，画出**已探索范围**（每格 = 1 个 region）。</string>
    <string name="plugin_world_guard_name">存档编辑警告</string>
    <string name="plugin_world_guard_desc">动存档前的检查清单 + 各存档体积一览。</string>
    <string name="plugin_whitelist_name">服务器白名单管理</string>
    <string name="plugin_whitelist_desc">查看 whitelist / ops / banned 四个文件的内容。</string>
    <string name="plugin_wiki_name">本地百科</string>
    <string name="plugin_wiki_desc">15 条原版速查：钻石、下界合金、末影珍珠、村民交易、刷怪塔…全离线。</string>
    <string name="plugin_migration_name">数据迁移向导</string>
    <string name="plugin_migration_desc">把设置 / 统计 / 笔记 / 词库打成一个 zip，换手机时带走。</string>
    <string name="plugin_gamerule_name">游戏规则预设</string>
    <string name="plugin_gamerule_desc">生存 / 创造 / PVP / 红石 / 建筑 / 空岛，生成数据包写进存档。</string>
