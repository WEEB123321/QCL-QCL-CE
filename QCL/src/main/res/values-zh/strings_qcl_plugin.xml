<resources>
    <string name="plugin_instance_icon_name">实例图标生成器</string>
    <string name="plugin_instance_icon_desc">按版本 / 加载器 / 模组数量自动给个底色和文字，也可以自己填。一键写进实例。</string>
    <string name="plugin_instance_diff_name">实例配置差异对比</string>
    <string name="plugin_instance_diff_desc">选两个实例，比模组 / 资源包 / 光影 / 配置的差异 —— 回答「为什么 A 能进 B 不能」。</string>
    <string name="plugin_instance_health_name">实例健康评分</string>
    <string name="plugin_instance_health_desc">扫版本文件、内存分配、模组数量、崩溃报告，给出 0–100 分和问题清单。</string>
    <string name="plugin_instance_history_name">实例启动历史</string>
    <string name="plugin_instance_history_desc">每次启动的时间、时长、按实例的启动次数，以及最近 20 次会话。</string>
    <string name="plugin_mod_tag_name">模组标签自动分类</string>
    <string name="plugin_mod_tag_desc">按文件名关键词把模组归成优化 / 建筑 / 科技 / 魔法 / 冒险 等，一眼看清装了什么。</string>
    <string name="plugin_mod_lock_name">模组锁定列表</string>
    <string name="plugin_mod_lock_desc">锁定不想被更新的模组（🔒 标记），存在本地，按实例分开记。</string>
    <string name="plugin_mod_dep_name">模组依赖树</string>
    <string name="plugin_mod_dep_desc">读每个模组自己声明的依赖，列出「谁依赖谁」并标出缺失的前置。</string>
    <string name="plugin_mod_downgrade_name">模组降级工具</string>
    <string name="plugin_mod_downgrade_desc">把某个模组换成你手动放进 mods 目录的指定版本。★ 替换前自动备份原文件。</string>
    <string name="plugin_changelog_name">更新日志聚合</string>
    <string name="plugin_changelog_desc">把 mods 里各 jar 自带的 CHANGELOG 读出来汇总。</string>
    <string name="plugin_pack_preview_name">资源包预览图</string>
    <string name="plugin_pack_preview_desc">直接看资源包里的方块/物品/界面贴图，不用进游戏。</string>
    <string name="plugin_shader_compat_name">光影兼容检测</string>
    <string name="plugin_shader_compat_desc">读光影包的 shaders/ 目录和 GLSL 版本号，判断它需要多新的渲染器。</string>
    <string name="plugin_batch_rename_name">批量重命名工具</string>
    <string name="plugin_batch_rename_desc">替换 / 前后缀 / 编号，改模组、资源包、光影、存档。★ 先预览再执行。</string>
    <string name="plugin_perf_bench_name">启动器性能基准</string>
    <string name="plugin_perf_bench_desc">累计启动次数、总时长、崩溃率、各实例对比。</string>
    <string name="plugin_dl_speed_name">下载源测速</string>
    <string name="plugin_dl_speed_desc">测官方源和 BMCLAPI 镜像能不能连、连得多快，推荐更快的那个。</string>
    <string name="plugin_dl_autoswitch_name">下载失败自动换源</string>
    <string name="plugin_dl_autoswitch_desc">某个源失败自动切下一个，可设重试次数。</string>
    <string name="plugin_dl_template_name">下载组合模板</string>
