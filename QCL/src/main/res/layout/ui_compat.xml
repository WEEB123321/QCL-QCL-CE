<?xml version="1.0" encoding="utf-8"?>
<!-- QCL 兼容性备忘页（社区版新增）。
     ★ 条目由 CompatUI 运行时构建；内置条目标「内置」，用户自建标「自建」，可删。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ui_compat"
    android:background="@color/launcher_ui_background"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_centerInParent="true"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/compat_subtitle" />

                <TextView
                    android:id="@+id/compat_instance"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/colorPureBlack" />

                <EditText
                    android:id="@+id/compat_search"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/qcl_button_gray"
                    android:hint="@string/compat_search_hint"
                    android:singleLine="true"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/colorPureBlack"
                    android:textColorHint="#99000000"
                    android:inputType="text" />

                <LinearLayout
                    android:id="@+id/compat_container"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/compat_add"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qcl_button_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/compat_add" />

                    <TextView
                        android:id="@+id/compat_export"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qcl_button_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/compat_export" />

                    <TextView
                        android:id="@+id/compat_import"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qcl_button_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/compat_import" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</LinearLayout>
