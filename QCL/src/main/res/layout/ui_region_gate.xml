<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     ★ 地区选择（下载页进入时的那一层，也用在「设置 → 下载 → 地区」）
     ★★★ 设计要点（为什么这么写）：
       ① 外框 FrameLayout 由代码决定「铺满下载页」还是「塞进 AlertDialog」，
          布局本身不关心位置 —— 一份 XML 两处复用，避免两份样式逐渐跑偏。
       ② 警告 TextView 用 20sp（= text_size_big），普通提示是 13sp。
          用户明确要求「选完中国后提示变大一点」，这里用 1.5 倍字号差表达
          「这条不是普通提示，是要你看清楚的那一条」。
       ③ 警告默认 gone，只有选中「中国大陆」才显示 —— 不选就不吓人。
       ④ 选中态用 android:state_selected（选项背景 selector 认这个状态），
          右侧小图标选中才可见，双击可辨。
     ========================================================================= -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/download_region_gate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_region_panel"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/region_gate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/region_gate_title"
                android:textColor="@color/colorPureBlack"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/region_gate_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:lineSpacingExtra="3dp"
                android:text="@string/region_gate_desc"
                android:textColor="@color/colorPureBlack"
                android:textSize="@dimen/text_size_middle" />

            <!-- ── 选项一：中国大陆 ────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/region_gate_cn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/launcher_region_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/region_gate_cn"
                    android:textColor="@color/colorPureBlack"
                    android:textSize="17sp" />

                <ImageView
                    android:id="@+id/region_gate_cn_check"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/ic_baseline_done_black"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- ── 选项二：其它地区 ────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/region_gate_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/launcher_region_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/region_gate_other"
                    android:textColor="@color/colorPureBlack"
                    android:textSize="17sp" />

                <ImageView
                    android:id="@+id/region_gate_other_check"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/ic_baseline_done_black"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- ── 中国用户警告：故意比普通提示大（20sp vs 13sp） ──────────── -->
            <LinearLayout
                android:id="@+id/region_gate_warn_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/launcher_view_light_gray"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/region_gate_warn_cn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/region_gate_warn_cn"
                    android:textColor="@color/colorAccent"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/region_gate_warn_cn_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.7"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/region_gate_warn_cn_sub"
                    android:textColor="@color/colorPureBlack"
                    android:textSize="@dimen/text_size_middle" />
            </LinearLayout>

            <!-- ── 确定：要连点 5 次才生效，前 4 次会跳到别的位置 ──────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/region_gate_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/launcher_region_confirm"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:text="@string/region_gate_confirm"
                    android:textColor="@color/colorPureBlack"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
