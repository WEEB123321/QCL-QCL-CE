<?xml version="1.0" encoding="utf-8"?>
<!-- QCL 自动任务页（社区版新增）。
     ★ 每行由 AutoTaskUI 运行时构建（标题 + 可点循环取值的当前值），
       不用 Switch 控件 —— 保持与备份页一致的灰色卡片观感，也避免 Switch 主题适配问题。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ui_auto_task"
    android:background="@color/launcher_ui_background"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_centerInParent="true"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/auto_task_subtitle" />

                <LinearLayout
                    android:id="@+id/auto_task_container"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/auto_task_run_now"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_marginTop="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/qcl_button_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/auto_task_run_now" />

                <TextView
                    android:id="@+id/auto_task_status"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="#99000000" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</LinearLayout>
