<?xml version="1.0" encoding="utf-8"?>
<!-- QCL 一级导航（社区版）——五个入口：首页 / 实例 / 下载 / 插件 / 我的。

     ★★★ 3.0：照参考图改成「**罗马数字 + 中文竖排**」，并且**去掉了图标**。
       参考图的导航栏本来就没有图标 —— 之前我自作主张加了图标，用户指出「图标用我给你的」。

     ★ 位置由 activity_main.xml 的 include 决定（alignParentStart + 满高 + 76dp 宽）。
     ★ id 一个都没改（qcl_bottom_nav / nav_tab_* / nav_text_*）——
       BottomNavHelper 和 MainActivity 全靠它们。
       （nav_icon_* 已不再使用，但 id 保留，免得别处引用报错。） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qcl_bottom_nav"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/qcl_bottom_nav_bg"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:visibility="gone"
    android:layout_width="76dp"
    android:layout_height="match_parent">


    <!-- ★★★ 侧栏顶部：品牌印记（参考图里那个「方框 + 字母」+ 下方小字）。
         参考图把它放在**侧栏顶部**，而不是顶部页眉 —— 这里照做。 -->
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="@string/main_brand_mark"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/qcl_brand_mark"
            android:textColor="@color/colorPureBlack"
            android:layout_width="34dp"
            android:layout_height="34dp"/>

        <TextView
            android:text="@string/main_brand_name"
            android:textSize="8sp"
            android:letterSpacing="0.28"
            android:textColor="@color/colorPureBlack"
            android:alpha="0.65"
            android:layout_marginTop="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- I home：罗马数字 + 中文竖排（参考图里导航就是这样的，没有图标） -->
    <LinearLayout
        android:id="@+id/nav_tab_home"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/qcl_nav_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:singleLine="true"
            android:text="@string/nav_numeral_1"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:textColor="@color/colorPureBlack"
            android:alpha="0.5"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/nav_text_home"
            android:text="@string/nav_v_home"
            android:textSize="11sp"
            android:lineSpacingExtra="1dp"
            android:letterSpacing="0.08"
            android:textColor="@color/colorPureBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- II instance：罗马数字 + 中文竖排（参考图里导航就是这样的，没有图标） -->
    <LinearLayout
        android:id="@+id/nav_tab_instance"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/qcl_nav_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:singleLine="true"
            android:text="@string/nav_numeral_2"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:textColor="@color/colorPureBlack"
            android:alpha="0.5"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/nav_text_instance"
            android:text="@string/nav_v_instance"
            android:textSize="11sp"
            android:lineSpacingExtra="1dp"
            android:letterSpacing="0.08"
            android:textColor="@color/colorPureBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- III download：罗马数字 + 中文竖排（参考图里导航就是这样的，没有图标） -->
    <LinearLayout
        android:id="@+id/nav_tab_download"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/qcl_nav_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:singleLine="true"
            android:text="@string/nav_numeral_3"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:textColor="@color/colorPureBlack"
            android:alpha="0.5"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/nav_text_download"
            android:text="@string/nav_v_download"
            android:textSize="11sp"
            android:lineSpacingExtra="1dp"
            android:letterSpacing="0.08"
            android:textColor="@color/colorPureBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- IV plugin：罗马数字 + 中文竖排（参考图里导航就是这样的，没有图标） -->
    <LinearLayout
        android:id="@+id/nav_tab_plugin"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/qcl_nav_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:singleLine="true"
            android:text="@string/nav_numeral_4"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:textColor="@color/colorPureBlack"
            android:alpha="0.5"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/nav_text_plugin"
            android:text="@string/nav_v_plugin"
            android:textSize="11sp"
            android:lineSpacingExtra="1dp"
            android:letterSpacing="0.08"
            android:textColor="@color/colorPureBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- V mine：罗马数字 + 中文竖排（参考图里导航就是这样的，没有图标） -->
    <LinearLayout
        android:id="@+id/nav_tab_mine"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/qcl_nav_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:singleLine="true"
            android:text="@string/nav_numeral_5"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:textColor="@color/colorPureBlack"
            android:alpha="0.5"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/nav_text_mine"
            android:text="@string/nav_v_mine"
            android:textSize="11sp"
            android:lineSpacingExtra="1dp"
            android:letterSpacing="0.08"
            android:textColor="@color/colorPureBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>


    <!-- ★★★ 侧栏底部：版本号（参考图里侧栏最下方那个 V2.4）。
         上面一条细线，下面小字。由 MainUI 填入真实版本号。 -->
    <View
        android:layout_width="26dp"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:background="@color/colorPureBlack"
        android:alpha="0.25"/>

    <TextView
        android:id="@+id/nav_app_version"
        android:singleLine="true"
        android:textSize="9sp"
        android:letterSpacing="0.12"
        android:textColor="@color/colorPureBlack"
        android:alpha="0.6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>
