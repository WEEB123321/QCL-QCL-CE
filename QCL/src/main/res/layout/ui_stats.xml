<?xml version="1.0" encoding="utf-8"?>
<!-- QCL 本地统计页（社区版新增）。
     ★ 结构：三张汇总卡（时长/启动/崩溃）+ 实例频次 + 最近会话 + 底部动作。
       列表项由 StatsUI 运行时构建，条数不写死。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ui_stats"
    android:background="@color/launcher_ui_background"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_centerInParent="true"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/stats_subtitle" />

                <!-- 三张汇总卡 -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_weight="1"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qcl_button_gray"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_total_time"
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            android:textColor="@color/colorPureBlack"
                            android:text="-" />

                        <TextView
                            android:layout_marginTop="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="#99000000"
                            android:text="@string/stats_label_time" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qcl_button_gray"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_launch_count"
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            android:textColor="@color/colorPureBlack"
                            android:text="-" />

                        <TextView
                            android:layout_marginTop="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="#99000000"
                            android:text="@string/stats_label_launch" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qcl_button_gray"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_crash_count"
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            android:textColor="@color/colorPureBlack"
                            android:text="-" />

                        <TextView
                            android:layout_marginTop="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="#99000000"
                            android:text="@string/stats_label_crash" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="16dp"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/stats_section_instance" />

                <TextView
                    android:id="@+id/stats_instance_empty"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="#99000000"
                    android:text="@string/stats_empty" />

                <LinearLayout
                    android:id="@+id/stats_instance_container"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="16dp"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/stats_section_session" />

                <LinearLayout
                    android:id="@+id/stats_session_container"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 动作 -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/stats_share"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qcl_button_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/stats_share" />

                    <TextView
                        android:id="@+id/stats_reset"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qcl_button_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/stats_reset" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</LinearLayout>
