<?xml version="1.0" encoding="utf-8"?>
<!-- QCL 启动诊断页（社区版新增）。
     ★★★ 收纳位置：按需求书「低频功能收进更多」——本页**不占底部导航**，
       入口挂在「我的 → 启动诊断」。
     ★ 设计意图：把「启动器走到哪一步」这件事变成用户自己能看见、能一键发出去的东西。
       在此之前，用户遇到闪退只能靠我远程猜；现在他自己就能把断点发过来。
     ★ 交互设计（低学习成本）：整页只有三个动作按钮 + 三段只读文本，
       没有任何需要理解的抽象概念；文本用等宽字体，方便对齐阅读和截图。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ui_diagnostic"
    android:background="@color/launcher_ui_background"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_centerInParent="true"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/diagnostic_ui_subtitle" />

                <!-- 三个动作：刷新 / 复制 / 分享。大按钮、横向等分，单手可点 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/diagnostic_refresh"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/qcl_button_gray"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/diagnostic_btn_refresh" />

                    <TextView
                        android:id="@+id/diagnostic_copy"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/qcl_button_gray"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/diagnostic_btn_copy" />

                    <TextView
                        android:id="@+id/diagnostic_share"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/qcl_button_gray"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="@color/colorPureBlack"
                        android:text="@string/diagnostic_btn_share" />

                </LinearLayout>

                <!-- ★ 社区版新增：自动排查（诊断向导）。
                     把最常出问题的六个环节做成逐项自检，每项给结论 + 人话建议，
                     玩家不需要理解任何术语。结果由 DiagnosticUI 运行时构建。 -->
                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="16dp"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/diagnostic_section_wizard" />

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="#99000000"
                    android:text="@string/diagnostic_wizard_hint" />

                <LinearLayout
                    android:id="@+id/diagnostic_wizard_container"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 上次启动没走完：只在真的发生时出现（平时整段隐藏，不占版面） -->
                <LinearLayout
                    android:id="@+id/diagnostic_last_section"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_middle"
                        android:textColor="#FFB3261E"
                        android:text="@string/diagnostic_section_last" />

                    <TextView
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="#99000000"
                        android:text="@string/diagnostic_last_hint" />

                    <TextView
                        android:id="@+id/diagnostic_last_text"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="6dp"
                        android:padding="10dp"
                        android:typeface="monospace"
                        android:background="@drawable/qcl_button_gray"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/colorPureBlack" />

                </LinearLayout>

                <!-- 本次启动路标 -->
                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="16dp"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/diagnostic_section_trace" />

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="#99000000"
                    android:text="@string/diagnostic_trace_hint" />

                <TextView
                    android:id="@+id/diagnostic_trace_text"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="6dp"
                    android:padding="10dp"
                    android:typeface="monospace"
                    android:background="@drawable/qcl_button_gray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/colorPureBlack" />

                <!-- 设备信息 -->
                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="16dp"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/diagnostic_section_device" />

                <TextView
                    android:id="@+id/diagnostic_device_text"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="6dp"
                    android:padding="10dp"
                    android:typeface="monospace"
                    android:background="@drawable/qcl_button_gray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/colorPureBlack" />

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="#99000000"
                    android:text="@string/diagnostic_tip" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</LinearLayout>
