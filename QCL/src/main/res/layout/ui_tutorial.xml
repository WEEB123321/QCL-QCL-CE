<?xml version="1.0" encoding="utf-8"?>
<!-- QCL 新手上路 / 常见问题页（社区版新增）。
     ★ 正文全部由 TutorialUI 从字符串数组构建，布局只提供容器 ——
       这样改文案不用动布局，也避免把几十条 Q&A 写死在 XML 里。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ui_tutorial"
    android:background="@color/launcher_ui_background"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_centerInParent="true"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/tutorial_subtitle" />

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="14dp"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/tutorial_section_steps" />

                <LinearLayout
                    android:id="@+id/tutorial_steps_container"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="16dp"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/tutorial_section_faq" />

                <LinearLayout
                    android:id="@+id/tutorial_faq_container"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tutorial_done"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/qcl_button_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/colorPureBlack"
                    android:text="@string/tutorial_done" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</LinearLayout>
