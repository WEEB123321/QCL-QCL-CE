<?xml version="1.0" encoding="utf-8"?>
    <manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.qcl.launcher">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.VIBRATE"/>
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ★ 社区版新增：下载进度通知。
         - POST_NOTIFICATIONS：Android 13(API 33) 起通知必须运行时授权，不授予时通知被静默丢弃；
         - FOREGROUND_SERVICE_DATA_SYNC：Android 14(API 34) 起按类型细分前台服务权限，
           下载属于 dataSync，缺它与清单里的 foregroundServiceType 会直接抛异常。 -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission
        android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"
        tools:ignore="HighSamplingRate" />
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.CHANGE_WIFI_STATE" />

    
    <!-- ★ Android 11+ 包可见性：外部渲染器（如 MobileGlues / VGPU 插件）通过
         「已安装应用的 nativeLibraryDir」提供 so，需要能查询到这些带启动图标的应用。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <!-- ★ 1.1.4：vivo/iQOO「游戏魔盒」。Android 11+ 的包可见性限制下，
             不声明就 getLaunchIntentForPackage("com.vivo.gamecube") 会返回 null。 -->
        <package android:name="com.vivo.gamecube" />
    </queries>
<application
        android:name=".launcher.QCLApplication"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true"
        android:icon="@drawable/ic_command_block"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_command_block"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:hasFragileUserData="true"
        android:allowNativeHeapPointerTagging="false"
        android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"
        tools:targetApi="32">
        <!--
          ★★★ 2026-09-17：应用启动入口由旧的 SplashActivity 改为「安装或更新运行环境」页。
          旧的 SplashActivity（三行标题 + 一条进度条、玩家看不见在装什么）已删除，
          它原本的「申请权限 → 初始化 → 解压基础文件」职责全部并入本页。
          现在打开 QCL 第一个看到的就是这个列表页：
            八项运行环境全部就绪 → 自动跳主界面（玩家看不到这一页）；
            有任何缺项        → 停在这一页，玩家点「安装 / 更新」。
          与 FCL 一致（FCL 是在主界面里挂 RuntimeFragment 做同样的事）。
        -->
        <activity
            android:name=".launcher.setting.RuntimeInstallActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:exported="true"
            android:name=".control.ImportControlActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition">
            <intent-filter
                android:scheme="content"
                android:label="@string/import_control_label"
                tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*"/>
            </intent-filter>
        </activity>

        <!-- ★ 社区版新增：从其它应用导入文件（分享 / 打开方式）。
             ★ 为什么另起一个 Activity：上面的 ImportControlActivity 是**空壳**
               （只做语言适配，收到 intent 后什么都不做），分享过来等于没反应。
               这里才是真正处理导入的地方：落地文件 → 让用户选放哪儿。
             ★ 只声明 zip 与图片两类 mimeType，不抢 application/octet-stream ——
               否则会变成「所有未知文件都推荐用 QCL 打开」，非常打扰。 -->
        <activity
            android:name=".launcher.share.ShareImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition">
            <!-- 分享进来（微信 / QQ / 文件管理器 → 分享到 QCL） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
            </intent-filter>
            <!-- 打开方式（文件管理器点开 .zip 时出现 QCL） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>

        <activity
            android:name=".launcher.MainActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:name=".auth.microsoft.MicrosoftLoginActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:name=".control.ControlPatternActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:name=".launcher.launch.ExitActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <activity
            android:launchMode="standard"
            android:multiprocess="true"
            android:name=".launcher.launch.pojav.PojavMinecraftActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HelloMinecraftLauncherPocketEdition"/>
        <service
            android:name=".launcher.download.ApiService"
            android:process=":apiService"
            android:enabled="true"
            android:exported="true" />
    
        <service
            android:name=".launcher.terracotta.TerracottaVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- ★ 社区版新增：下载进度通知的前台服务。
             只做「持有通知 + 转发按钮点击」，下载逻辑仍在 DownloadTask 里。
             foregroundServiceType="dataSync" 在 Android 14+ 是强制项。 -->
        <service
            android:name=".launcher.download.DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ★ 说明（社区版）：分享文件用的 FileProvider **不在这里另建**。
             FilePicker 模块已经声明了一个 FileProvider（authority = @string/filebrowser_provider，
             路径表是 external-path path="." 即整个外部存储），而 FilePicker 是本 App 的
             库模块、清单会合并进来 —— 所以直接用那一个就够了。
             另建一个会因为「同一个类 + 同一个 meta-data 键」和它冲突，清单合并直接失败。
             分享时代码里用 getPackageName() + ".filepicker.provider" 拿它的 authority。 -->

        <!-- ★ 社区版新增：桌面小部件（显示当前实例 / 游戏时长 / 备份份数；
             点最下面一行直接一键启动）。
             updatePeriodMillis=0 —— 不让系统周期唤醒，改由启动器打开时主动刷新。 -->
        <receiver
            android:name=".launcher.widget.QclStatusWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/qcl_status_widget_info" />
        </receiver>


        <activity
            android:name=".launcher.CrashReportActivity"
            android:screenOrientation="landscape"
            android:process=":crash"
            android:exported="false"
            android:excludeFromRecents="true" />

        </application>

</manifest>
